{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "../.github/workflows/ci.yml",
        "../package.json",
        "../android/**",
        "!../android/build/**",
        "!../android/.gradle/**",
        "!../android/.cxx/**",
        "../src/*.ts",
        "../src/*.tsx",
        "package.json",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!android/app/.cxx/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "../.github/workflows/ci.yml",
        "../package.json",
        "../*.podspec",
        "../ios/**",
        "../src/*.ts",
        "../src/*.tsx",
        "package.json",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": [".turbo/cache"]
    }
  }
}
